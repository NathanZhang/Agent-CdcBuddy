# SiliconFlow 硅基流动大模型服务配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.6-27B
# 技能选择开启模型推理与流式展示；已有证据的文字汇总关闭推理，避免耗尽答复预算。
# 不支持推理的兼容服务可设为 false；length 截断会关闭推理、增大答复预算并重生成一次。
SILICONFLOW_ENABLE_THINKING=true
# Qwen3.8 兼容网关的技能选择推理档位：low / medium / xhigh；默认 medium，避免模型默认 xhigh。
# 汇总、关闭推理及 length 恢复时不发送档位；其他模型和 SiliconFlow 继续使用原有参数。
SILICONFLOW_REASONING_EFFORT=medium
# 所有业务 LLM 调用默认请求流式；有有效输出就续期，不设默认整轮总时限。
# 传输心跳、空片段不续期。标题生成仍独立限时8秒；工具执行预算独立。
SILICONFLOW_FIRST_OUTPUT_TIMEOUT_MS=300000
SILICONFLOW_IDLE_TIMEOUT_MS=180000
# 供应商忽略 stream:true 返回完整JSON时，无法观察生成进度，按单次总等待兜底。
SILICONFLOW_NON_STREAM_TIMEOUT_MS=300000
# 旧变量仍兼容：未配置对应的新变量时，作为该调用路径的首输出/空闲等待值。
# SILICONFLOW_ROUTER_TIMEOUT_MS=60000
# SILICONFLOW_TEXT2SQL_TIMEOUT_MS=60000

# 国家地理信息公共服务平台 天地图 Tianditu 开发者 Key
NEXT_PUBLIC_TIANDITU_KEY=your_tianditu_key_here

# LLM 地域识别和服务器范围批准默认开启；关闭时自由文本拒绝，结构化地图操作可用。
LLM_REGION_INTENT_ENABLED=true

# 手机图片识别：填写当前服务支持的多模态模型ID；未配置时明确返回不可用。
SILICONFLOW_VISION_MODEL=

# ICD-10 mortality selection: JSON argv of the authorized Iris 5 native worker.
# No default/mock engine. Never place these server-side values in NEXT_PUBLIC_*.
# CDC_IRIS_COMMAND=["C:\\Python\\python.exe","C:\\CdcBuddy\\scripts\\iris-native-worker.py"]
# CDC_IRIS_NATIVE_CONFIG=C:\CdcBuddyIris\native-config.json
# CDC_IRIS_TIMEOUT_SECONDS=60
