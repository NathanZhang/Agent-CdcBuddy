# SiliconFlow 硅基流动大模型服务配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.6-27B
# 对话开启模型推理与流式展示；不支持推理的兼容服务可设为 false。
SILICONFLOW_ENABLE_THINKING=true
# 流式请求：首次输出及相邻有效输出之间的最长等待；持续输出时不限制总时长。
# 非流式请求仍使用此值作为单次请求总时限。
SILICONFLOW_ROUTER_TIMEOUT_MS=60000
SILICONFLOW_TEXT2SQL_TIMEOUT_MS=60000

# 国家地理信息公共服务平台 天地图 Tianditu 开发者 Key
NEXT_PUBLIC_TIANDITU_KEY=your_tianditu_key_here
